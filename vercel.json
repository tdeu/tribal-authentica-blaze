{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd app && npm ci",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tribal-authentica.vercel.app"
        }
      ],
      "destination": "https://sankofa-bch.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "tribal-authentica.vercel.app"
        }
      ],
      "destination": "https://sankofa-bch.vercel.app/:path+",
      "permanent": true
    }
  ]
}
