pragma cashscript ^0.14.0;

// Tribal Authentica — PatronDispenser (spec: contracts/SPEC.md)
//
// Holds a stock of FUNGIBLE "Patron" tokens, split over several UTXOs so claims can run in parallel.
// claim(): anyone gets exactly 1 token by paying the artisan >= patronPriceSats.
//
// Output layout:
//   stock > 1:  [0] stock - 1 back here   [1] artisan >= price                     [2] 1 token, any address
//   stock = 1:  [0] artisan >= price + the BCH this UTXO carried                    [1] 1 token, any address
// The last claim on a UTXO leaves nothing behind at the contract.
//
// patronCategory is in VM byte order (reversed from the txid explorers show).
// patronPriceSats >= 546 is enforced by the deploy script.
contract PatronDispenser(bytes artisanLockingBytecode, int patronPriceSats, bytes32 patronCategory) {
    function claim() {
        require(this.activeInputIndex == 0, "dispenser must be input 0");
        require(tx.inputs[0].tokenCategory == patronCategory, "not a Patron stock UTXO");
        int stock = tx.inputs[0].tokenAmount;
        require(stock >= 1, "empty stock");

        int artisanIndex = 0;
        int artisanMin = patronPriceSats + tx.inputs[0].value;
        if (stock > 1) {
            require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, "stock must return to the dispenser");
            require(tx.outputs[0].tokenCategory == patronCategory, "stock category changed");
            require(tx.outputs[0].tokenAmount == stock - 1, "stock must shrink by exactly 1");
            require(tx.outputs[0].value >= tx.inputs[0].value, "dispenser value drained");
            artisanIndex = 1;
            artisanMin = patronPriceSats;
        }

        require(tx.outputs[artisanIndex].lockingBytecode == artisanLockingBytecode, "must pay the artisan");
        require(tx.outputs[artisanIndex].value >= artisanMin, "artisan underpaid");
        require(tx.outputs[artisanIndex + 1].tokenCategory == patronCategory, "claim output must carry a Patron token");
        require(tx.outputs[artisanIndex + 1].tokenAmount == 1, "claim must be exactly 1 token");
    }
}
